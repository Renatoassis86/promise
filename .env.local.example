# SUPABASE CONFIGURATION - PROMISE ENGLISH
# Copie este arquivo para .env.local e preencha com as credenciais do projeto
# Supabase da Promisse (Project Settings > API no dashboard do Supabase).
# SUPABASE_SERVICE_ROLE_KEY tem acesso total ao banco (bypassa RLS) -- nunca
# comitar, nunca expor em codigo que roda no browser. Rode supabase_schema.sql
# no SQL Editor do projeto antes do primeiro uso.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
